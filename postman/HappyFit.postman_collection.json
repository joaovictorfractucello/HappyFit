                "exec": [
                  "pm.test(\"201 sessao iniciada com snapshot\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.exercises[0].sets).to.eql([]);",
                  "  pm.expect(body.exercises[0].plannedLoad).to.eql(40);",
